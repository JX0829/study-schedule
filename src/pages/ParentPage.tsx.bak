/**
 * 家长端设置页面 - 增强版
 */

import { useState, useEffect, useMemo } from "react";
import {
  Page,
  Card,
  Button,
  Badge,
  Tabs,
  Icon,
  PointsSlider,
} from "@/components";
import {
  useFamilyStore,
  useTaskStore,
  useRewardStore,
  usePasswordStore,
  useTemplateStore,
  usePointsStore,
} from "@/store";
import { getToday, formatDate, getWeekDayName } from "@/utils/date";
import { defaultSystemConfig } from "@/utils/presets";
import type { SystemConfig } from "@/types";
import type { TaskTemplateItem, RewardTemplateItem } from "@/store/template";

export function ParentPage() {
  const [activeTab, setActiveTab] = useState("today");
  const [showSignPassword, setShowSignPassword] = useState(true); // 默认显示密码

  // Store
  const family = useFamilyStore((state) => state.family);
  const users = useFamilyStore((state) => state.users);
  const rewards = useRewardStore((state) => state.rewards);
  const addReward = useRewardStore((state) => state.addReward);
  const deleteReward = useRewardStore((state) => state.deleteReward);
  const getSignPassword = usePasswordStore((state) => state.getSignPassword);
  const generateSignPassword = usePasswordStore(
    (state) => state.generateSignPassword,
  );
  const logout = usePasswordStore((state) => state.logout);

  // 任务相关
  const dailyTasks = useTaskStore((state) => state.dailyTasks);
  const getDailyTasksByDate = useTaskStore((state) => state.getDailyTasksByDate);
  const updateDailyTaskStatus = useTaskStore((state) => state.updateDailyTaskStatus);
  
  // 积分相关
  const getChildPoints = usePointsStore((state) => state.getChildPoints);
  const earnPoints = usePointsStore((state) => state.earnPoints);
  const addPointsRecord = usePointsStore((state) => state.addPointsRecord);

  const taskTemplates = useTemplateStore((state) => state.taskTemplates);
  const addTaskTemplate = useTemplateStore((state) => state.addTaskTemplate);
  const updateTaskTemplate = useTemplateStore(
    (state) => state.updateTaskTemplate,
  );
  const deleteTaskTemplate = useTemplateStore(
    (state) => state.deleteTaskTemplate,
  );
  const rewardTemplates = useTemplateStore((state) => state.rewardTemplates);
  const addRewardTemplate = useTemplateStore(
    (state) => state.addRewardTemplate,
  );
  const updateRewardTemplate = useTemplateStore(
    (state) => state.updateRewardTemplate,
  );
  const deleteRewardTemplate = useTemplateStore(
    (state) => state.deleteRewardTemplate,
  );
  const initDefaultTemplates = useTemplateStore(
    (state) => state.initDefaultTemplates,
  );
  const saveTaskTemplates = useTemplateStore(
    (state) => state.saveTaskTemplates,
  );
  const saveRewardTemplates = useTemplateStore(
    (state) => state.saveRewardTemplates,
  );

  // 家庭信息编辑
  const [editingFamily, setEditingFamily] = useState(false);
  const [familyName, setFamilyName] = useState(family?.name || "");

  // 积分配置
  const [pointsConfig, setPointsConfig] =
    useState<SystemConfig>(defaultSystemConfig);

  // 任务模板编辑
  const [showAddTaskTemplate, setShowAddTaskTemplate] = useState(false);
  const [newTemplateName, setNewTemplateName] = useState("");
  const [newTemplatePoints, setNewTemplatePoints] = useState("");
  const [newTemplateType, setNewTemplateType] = useState<
    "homework" | "practice" | "habit"
  >("habit");
  const [editingTaskTemplate, setEditingTaskTemplate] = useState<string | null>(
    null,
  );

  // 任务剪切板批量导入
  const [showClipboardImport, setShowClipboardImport] = useState(false);
  const [clipboardText, setClipboardText] = useState("");
  const [importPreview, setImportPreview] = useState<
    Array<{ name: string; points: number }>
  >([]);
  const [importType, setImportType] = useState<
    "homework" | "practice" | "habit"
  >("habit");

  // 奖惩模板编辑
  const [showAddRewardTemplate, setShowAddRewardTemplate] = useState(false);
  const [newRewardTemplateName, setNewRewardTemplateName] = useState("");
  const [newRewardTemplatePoints, setNewRewardTemplatePoints] = useState("");
  const [editingRewardTemplate, setEditingRewardTemplate] = useState<
    string | null
  >(null);

  // 奖惩剪切板批量导入
  const [showRewardClipboardImport, setShowRewardClipboardImport] =
    useState(false);
  const [rewardClipboardText, setRewardClipboardText] = useState("");
  const [rewardImportPreview, setRewardImportPreview] = useState<
    Array<{ name: string; points: number }>
  >([]);

  // 奖励编辑
  const [showAddReward, setShowAddReward] = useState(false);
  const [newRewardName, setNewRewardName] = useState("");
  const [newRewardCost, setNewRewardCost] = useState("");

  const parent = users.find((u) => u.role === "parent");
  const child = users.find((u) => u.role === "child");

  // 获取今日签字密码
  const signPassword = getSignPassword();

  useEffect(() => {
    generateSignPassword();
  }, []);

  // 今日任务相关
  const [currentDate, setCurrentDate] = useState(getToday());
  
  // 发放额外奖励相关
  const [showBonusModal, setShowBonusModal] = useState(false);
  const [bonusPoints, setBonusPoints] = useState(10);
  const [bonusDescription, setBonusDescription] = useState("");
  
  // 获取今日任务
  const todayTasks = useMemo(() => {
    return getDailyTasksByDate(currentDate);
  }, [currentDate, dailyTasks]);
  
  // 按状态分组
  const pendingTasks = todayTasks.filter(t => t.status === 'pending');
  const completedTasks = todayTasks.filter(t => t.status === 'completed');
  const submittedTasks = todayTasks.filter(t => t.status === 'submitted');
  
  // 计算进度
  const progress = useMemo(() => {
    const completed = todayTasks.filter(t => t.status === 'completed').length;
    const pointsEarned = todayTasks
      .filter(t => t.status === 'completed')
      .reduce((sum, t) => sum + t.points, 0);
    const pendingPoints = todayTasks
      .filter(t => t.status === 'pending' || t.status === 'submitted')
      .reduce((sum, t) => sum + t.points, 0);
    return { completed, total: todayTasks.length, pointsEarned, totalPoints: pointsEarned + pendingPoints };
  }, [todayTasks]);
  
  // 获取孩子积分
  const childPoints = child ? getChildPoints(child.id) : null;
  
  // 日期切换
  const prevDay = () => {
    const prev = new Date(currentDate);
    prev.setDate(prev.getDate() - 1);
    setCurrentDate(formatDate(prev));
  };
  
  const nextDay = () => {
    const next = new Date(currentDate);
    next.setDate(next.getDate() + 1);
    setCurrentDate(formatDate(next));
  };

  // 添加任务模板
  const handleAddTaskTemplate = () => {
    if (!family || !newTemplateName || !newTemplatePoints) return;

    addTaskTemplate({
      familyId: family.id,
      name: newTemplateName,
      type: newTemplateType,
      points: parseInt(newTemplatePoints),
      isCustom: true,
    });

    setNewTemplateName("");
    setNewTemplatePoints("");
    setShowAddTaskTemplate(false);
  };

  // 开始编辑任务模板
  const startEditTaskTemplate = (template: TaskTemplateItem) => {
    setEditingTaskTemplate(template.id);
    setNewTemplateName(template.name);
    setNewTemplatePoints(String(template.points));
    setNewTemplateType(template.type);
    setShowAddTaskTemplate(true);
  };

  // 保存任务模板编辑
  const handleSaveTaskTemplate = () => {
    if (!editingTaskTemplate || !newTemplateName || !newTemplatePoints) return;

    updateTaskTemplate(editingTaskTemplate, {
      name: newTemplateName,
      points: parseInt(newTemplatePoints),
      type: newTemplateType,
    });

    setEditingTaskTemplate(null);
    setNewTemplateName("");
    setNewTemplatePoints("");
    setShowAddTaskTemplate(false);
  };

  // 添加奖惩模板
  const handleAddRewardTemplate = () => {
    if (!family || !newRewardTemplateName || !newRewardTemplatePoints) return;

    addRewardTemplate({
      familyId: family.id,
      name: newRewardTemplateName,
      points: parseInt(newRewardTemplatePoints),
      isCustom: true,
    });

    setNewRewardTemplateName("");
    setNewRewardTemplatePoints("");
    setShowAddRewardTemplate(false);
  };

  // 开始编辑奖惩模板
  const startEditRewardTemplate = (template: RewardTemplateItem) => {
    setEditingRewardTemplate(template.id);
    setNewRewardTemplateName(template.name);
    setNewRewardTemplatePoints(String(template.points));
    setShowAddRewardTemplate(true);
  };

  // 保存奖惩模板编辑
  const handleSaveRewardTemplate = () => {
    if (
      !editingRewardTemplate ||
      !newRewardTemplateName ||
      !newRewardTemplatePoints
    )
      return;

    updateRewardTemplate(editingRewardTemplate, {
      name: newRewardTemplateName,
      points: parseInt(newRewardTemplatePoints),
    });

    setEditingRewardTemplate(null);
    setNewRewardTemplateName("");
    setNewRewardTemplatePoints("");
    setShowAddRewardTemplate(false);
  };

  // 初始化默认模板
  const handleInitDefaultTemplates = () => {
    if (!family) return;
    initDefaultTemplates(family.id);
  };

  // 解析剪切板文本，提取任务名称和分值
  // 格式：任务名称(分值)
  const parseClipboardText = (text: string) => {
    const lines = text.split("\n").filter((line) => line.trim());
    const result: Array<{ name: string; points: number }> = [];

    for (const line of lines) {
      // 匹配格式：任务名称(分值) 或 任务名称（分值）
      const match = line.match(/(.+)\(([\d-]+)\)|(.+)\uff08([\d-]+)\uff09/);
      if (match) {
        const name = (match[1] || match[3]).trim();
        const points = parseInt(match[2] || match[4]);
        if (name && !isNaN(points)) {
          result.push({ name, points });
        }
      }
    }

    return result;
  };

  // 执行剪切板批量导入（追加）
  const handleClipboardImport = () => {
    if (!family || importPreview.length === 0) return;

    importPreview.forEach((item) => {
      addTaskTemplate({
        familyId: family.id,
        name: item.name,
        type: importType,
        points: item.points,
        isCustom: true,
      });
    });

    setShowClipboardImport(false);
    setClipboardText("");
    setImportPreview([]);
  };

  // 执行剪切板批量保存（覆盖已有）
  const handleClipboardSave = () => {
    if (!family || importPreview.length === 0) return;

    saveTaskTemplates(family.id, importPreview.map(item => ({
      name: item.name,
      type: importType,
      points: item.points,
      isCustom: true,
    })));

    setShowClipboardImport(false);
    setClipboardText("");
    setImportPreview([]);
  };

  // 执行奖惩剪切板批量导入（追加）
  const handleRewardClipboardImport = () => {
    if (!family || rewardImportPreview.length === 0) return;

    rewardImportPreview.forEach((item) => {
      addRewardTemplate({
        familyId: family.id,
        name: item.name,
        points: item.points,
        isCustom: true,
      });
    });

    setShowRewardClipboardImport(false);
    setRewardClipboardText("");
    setRewardImportPreview([]);
  };

  // 执行奖惩剪切板批量保存（覆盖已有）
  const handleRewardClipboardSave = () => {
    if (!family || rewardImportPreview.length === 0) return;

    saveRewardTemplates(family.id, rewardImportPreview.map(item => ({
      name: item.name,
      points: item.points,
      isCustom: true,
    })));

    setShowRewardClipboardImport(false);
    setRewardClipboardText("");
    setRewardImportPreview([]);
  };

  // 添加奖励
  const handleAddReward = () => {
    if (!family || !newRewardName || !newRewardCost) return;

    addReward({
      familyId: family.id,
      name: newRewardName,
      cost: parseInt(newRewardCost),
      isActive: true,
    });

    setNewRewardName("");
    setNewRewardCost("");
    setShowAddReward(false);
  };

  // 退出登录
  // 家长端直接签字确认任务（不需要密码）
  const handleDirectConfirmTask = (taskId: string) => {
    if (!child || !parent) return;
    
    const task = todayTasks.find(t => t.id === taskId);
    if (!task) return;
    
    // 更新任务状态为已完成
    updateDailyTaskStatus(taskId, 'completed', {
      confirmedAt: new Date().toISOString(),
      confirmedBy: parent.id,
    });
    
    // 积分入账
    earnPoints(child.id, task.points, taskId, `完成任务: ${task.name}`);
  };
      <div className="px-4 py-3 bg-parent-500 backdrop-blur-sm sticky top-0 z-10">
        <div className="w-full md:max-w-2xl md:mx-auto lg:max-w-4xl flex items-center justify-between">
          <div className="flex items-center gap-2">
            <span className="text-2xl">👨‍👩‍👧</span>
            <div>
              <div className="font-medium text-white">家长端</div>
              <div className="text-xs text-blue-100">{family?.name}</div>
            </div>
          </div>
          <Button
            size="sm"
            variant="ghost"
            onClick={handleLogout}
            className="text-white"
          >
            退出
          </Button>
        </div>
      </div>

      {/* Tabs */}
      <div className="bg-white sticky top-[52px] z-9 border-b">
        <div className="w-full md:max-w-2xl md:mx-auto lg:max-w-4xl overflow-x-auto px-4">
          <Tabs tabs={tabs} activeKey={activeTab} onChange={setActiveTab} />
        </div>
      </div>

      {/* 内容区域 */}
      <div className="w-full md:max-w-2xl md:mx-auto lg:max-w-4xl px-4 py-4">
        {/* 签字密码 */}
        {activeTab === "sign" && (
          <div className="space-y-4">
            <Card>
              <h3 className="font-medium text-gray-700 mb-4 flex items-center gap-2">
                <Icon name="lock" size={20} />
                今日签字密码
              </h3>

              <div className="flex items-center justify-center gap-4 py-4">
                <div className="text-3xl font-mono px-6 py-3 bg-blue-50 rounded-lg text-blue-600 font-bold">
                  {signPassword}
                </div>
                <button
                  onClick={() => setShowSignPassword(!showSignPassword)}
                  className="p-3 text-gray-500 hover:text-gray-700 bg-gray-100 rounded-lg"
                  title="点击切换显示"
                >
                  {showSignPassword ? "👁️" : "👁️‍🗨️"}
                </button>
              </div>

              <p className="text-gray-500 text-sm text-center mb-4">
                此密码用于确认孩子任务完成，每日随机生成
              </p>
            </Card>

            <Card className="bg-blue-50 border-blue-200">
              <h3 className="font-medium text-blue-700 mb-2">
                💡 签字密码说明
              </h3>
              <div className="text-sm text-blue-600 space-y-1">
                <p>• 签字密码每天自动生成，4位随机字符</p>
                <p>• 孩子完成任务后需要家长签字确认</p>
                <p>• 输入正确签字密码后积分才能入账</p>
                <p>• 点击眼睛按钮可以显示/隐藏密码</p>
              </div>
            </Card>
          </div>
        )}

        {/* 任务模板 */}
        {activeTab === "templates" && (
          <div className="space-y-4">
            <Card>
              <h3 className="font-medium text-gray-700 mb-3 flex items-center gap-2">
                <Icon name="calendar" size={20} />
                任务模板
              </h3>

              {taskTemplates.length > 0 ? (
                <div className="space-y-2">
                  {taskTemplates.map((template) => (
                    <div
                      key={template.id}
                      className="border rounded-lg p-3 flex items-center justify-between"
                    >
                      <div>
                        <div className="font-medium">{template.name}</div>
                        <div className="flex items-center gap-2 mt-1">
                          <Badge
                            color={
                              template.type === "homework"
                                ? "blue"
                                : template.type === "practice"
                                  ? "purple"
                                  : "success"
                            }
                          >
                            {template.type === "homework"
                              ? "作业"
                              : template.type === "practice"
                                ? "练习"
                                : "习惯"}
                          </Badge>
                          <Badge color="primary">+{template.points}分</Badge>
                        </div>
                      </div>
                      <div className="flex gap-1">
                        <Button
                          size="sm"
                          variant="secondary"
                          onClick={() => startEditTaskTemplate(template)}
                        >
                          编辑
                        </Button>
                        <Button
                          size="sm"
                          variant="danger"
                          onClick={() => deleteTaskTemplate(template.id)}
                        >
                          删除
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="text-center py-8">
                  <Icon
                    name="calendar"
                    size={40}
                    className="text-gray-300 mb-3"
                  />
                  <p className="text-gray-500 mb-4">暂无任务模板</p>
                  <Button onClick={handleInitDefaultTemplates}>
                    导入默认模板
                  </Button>
                </div>
              )}
            </Card>

            {/* 添加任务模板 */}
            {showAddTaskTemplate ? (
              <Card>
                <h3 className="font-medium text-gray-700 mb-3">添加任务模板</h3>
                <div className="space-y-3">
                  <input
                    type="text"
                    value={newTemplateName}
                    onChange={(e) => setNewTemplateName(e.target.value)}
                    placeholder="任务名称"
                    className="w-full px-3 py-2 border rounded-lg"
                  />
                  <div className="flex items-center gap-2">
                    <div className="flex-1">
                      <PointsSlider
                        value={
                          newTemplatePoints ? parseInt(newTemplatePoints) : 0
                        }
                        onChange={(val) => setNewTemplatePoints(String(val))}
                        min={-50}
                        max={50}
                        label="积分分值"
                      />
                    </div>
                    <div className="flex-1">
                      <label className="text-gray-500 text-sm">类型</label>
                      <select
                        value={newTemplateType}
                        onChange={(e) =>
                          setNewTemplateType(
                            e.target.value as "homework" | "practice" | "habit",
                          )
                        }
                        className="w-full px-3 py-2 border rounded-lg mt-1"
                      >
                        <option value="homework">作业</option>
                        <option value="practice">练习</option>
                        <option value="habit">习惯</option>
                      </select>
                    </div>
                  </div>
                  <div className="flex gap-2">
                    <Button
                      onClick={
                        editingTaskTemplate
                          ? handleSaveTaskTemplate
                          : handleAddTaskTemplate
                      }
                    >
                      {editingTaskTemplate ? "保存" : "添加"}
                    </Button>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        setShowAddTaskTemplate(false);
                        setEditingTaskTemplate(null);
                        setNewTemplateName("");
                        setNewTemplatePoints("");
                      }}
                    >
                      取消
                    </Button>
                  </div>
                </div>
              </Card>
            ) : (
              <div className="space-y-2">
                <Button
                  className="w-full"
                  onClick={() => setShowAddTaskTemplate(true)}
                >
                  + 添加任务模板
                </Button>
                <Button
                  variant="secondary"
                  className="w-full"
                  onClick={() => setShowClipboardImport(true)}
                >
                  📋剪切板批量导入
                </Button>
              </div>
            )}

            {/* 剪切板批量导入模态框 */}
            {showClipboardImport && (
              <Card>
                <h3 className="font-medium text-gray-700 mb-3">
                  📋剪切板批量导入
                </h3>
                <p className="text-gray-500 text-sm mb-3">
                  从 Excel 复制数据，格式：任务名称(分值)，例如：完成作业(10)
                </p>
                <textarea
                  value={clipboardText}
                  onChange={(e) => {
                    setClipboardText(e.target.value);
                    setImportPreview(parseClipboardText(e.target.value));
                  }}
                  placeholder="每天自己规划自己的学习和生活(5)\n完成自己规划的任务（5）\n放假期间22:00前上床(2)\n..."
                  className="w-full px-3 py-2 border rounded-lg min-h-[120px]"
                />

                {/* 预览解析结果 */}
                {importPreview.length > 0 && (
                  <div className="mt-3">
                    <div className="flex items-center justify-between mb-2">
                      <label className="text-gray-500 text-sm">任务类型</label>
                      <select
                        value={importType}
                        onChange={(e) =>
                          setImportType(
                            e.target.value as "homework" | "practice" | "habit",
                          )
                        }
                        className="px-3 py-1 border rounded-lg"
                      >
                        <option value="homework">作业</option>
                        <option value="practice">练习</option>
                        <option value="habit">习惯</option>
                      </select>
                    </div>
                    <div className="border rounded-lg p-2 bg-gray-50">
                      <p className="text-gray-500 text-sm mb-2">
                        预览（{importPreview.length} 个任务）：
                      </p>
                      <div className="max-h-[200px] overflow-y-auto">
                        {importPreview.map((item, idx) => (
                          <div
                            key={idx}
                            className="flex items-center justify-between py-1 border-b border-gray-200 last:border-0"
                          >
                            <span className="text-gray-700">{item.name}</span>
                            <Badge color="primary">+{item.points}分</Badge>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                <div className="flex gap-2 mt-4">
                  <Button
                    onClick={handleClipboardImport}
                    disabled={importPreview.length === 0}
                  >
                    追加{" "}
                    {importPreview.length > 0 && `(${importPreview.length}个)`}
                  </Button>
                  <Button
                    variant="secondary"
                    onClick={handleClipboardSave}
                    disabled={importPreview.length === 0}
                  >
                    保存并覆盖{" "}
                    {importPreview.length > 0 && `(${importPreview.length}个)`}
                  </Button>
                  <Button
                    variant="ghost"
                    onClick={() => {
                      setShowClipboardImport(false);
                      setClipboardText("");
                      setImportPreview([]);
                    }}
                  >
                    取消
                  </Button>
                </div>
              </Card>
            )}

            {/* 剪切板导入说明 */}
            {!showAddTaskTemplate &&
              !showClipboardImport &&
              taskTemplates.length === 0 && (
                <Card className="bg-parent-50 border-parent-200">
                  <h3 className="font-medium text-parent-700 mb-2">
                    💡快速导入提示
                  </h3>
                  <div className="text-sm text-parent-600 space-y-1">
                    <p>•点击"剪切板批量导入"从 Excel 快速导入</p>
                    <p>•格式：任务名称(分值)，如：完成作业(10)</p>
                    <p>•支持中文括号（）和英文括号()</p>
                  </div>
                </Card>
              )}
          </div>
        )}

        {/* 奖惩模板 */}
        {activeTab === "rewards" && (
          <div className="space-y-4">
            <Card>
              <h3 className="font-medium text-gray-700 mb-3 flex items-center gap-2">
                <Icon name="star" size={20} />
                奖惩模板
              </h3>

              {rewardTemplates.length > 0 ? (
                <div className="space-y-2">
                  {rewardTemplates.map((template) => (
                    <div
                      key={template.id}
                      className="border rounded-lg p-3 flex items-center justify-between"
                    >
                      <div>
                        <div className="font-medium">{template.name}</div>
                        <Badge
                          color={template.points > 0 ? "success" : "danger"}
                        >
                          {template.points > 0
                            ? `+${template.points}`
                            : template.points}
                          分
                        </Badge>
                      </div>
                      <div className="flex gap-1">
                        <Button
                          size="sm"
                          variant="secondary"
                          onClick={() => startEditRewardTemplate(template)}
                        >
                          编辑
                        </Button>
                        <Button
                          size="sm"
                          variant="danger"
                          onClick={() => deleteRewardTemplate(template.id)}
                        >
                          删除
                        </Button>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="text-center py-8">
                  <Icon name="star" size={40} className="text-gray-300 mb-3" />
                  <p className="text-gray-500 mb-4">暂无奖惩模板</p>
                  <Button onClick={handleInitDefaultTemplates}>
                    导入默认模板
                  </Button>
                </div>
              )}
            </Card>

            {/* 添加奖惩模板 */}
            {showAddRewardTemplate ? (
              <Card>
                <h3 className="font-medium text-gray-700 mb-3">添加奖惩模板</h3>
                <div className="space-y-3">
                  <input
                    type="text"
                    value={newRewardTemplateName}
                    onChange={(e) => setNewRewardTemplateName(e.target.value)}
                    placeholder="奖惩名称（如：考试进步）"
                    className="w-full px-3 py-2 border rounded-lg"
                  />
                  <PointsSlider
                    value={
                      newRewardTemplatePoints
                        ? parseInt(newRewardTemplatePoints)
                        : 0
                    }
                    onChange={(val) => setNewRewardTemplatePoints(String(val))}
                    min={-50}
                    max={50}
                    label="分值（正数奖励，负数惩罚）"
                  />
                  <div className="flex gap-2">
                    <Button
                      onClick={
                        editingRewardTemplate
                          ? handleSaveRewardTemplate
                          : handleAddRewardTemplate
                      }
                    >
                      {editingRewardTemplate ? "保存" : "添加"}
                    </Button>
                    <Button
                      variant="secondary"
                      onClick={() => {
                        setShowAddRewardTemplate(false);
                        setEditingRewardTemplate(null);
                        setNewRewardTemplateName("");
                        setNewRewardTemplatePoints("");
                      }}
                    >
                      取消
                    </Button>
                  </div>
                </div>
              </Card>
            ) : (
              <div className="space-y-2">
                <Button
                  className="w-full"
                  onClick={() => setShowAddRewardTemplate(true)}
                >
                  + 添加奖惩模板
                </Button>
                <Button
                  variant="secondary"
                  className="w-full"
                  onClick={() => setShowRewardClipboardImport(true)}
                >
                  📋剪切板批量导入
                </Button>
              </div>
            )}

            {/* 奖惩剪切板批量导入模态框 */}
            {showRewardClipboardImport && (
              <Card>
                <h3 className="font-medium text-gray-700 mb-3">
                  📋剪切板批量导入
                </h3>
                <p className="text-gray-500 text-sm mb-3">
                  从 Excel 复制数据，格式：奖惩名称(分值)，例如：考试进步(10)
                </p>
                <textarea
                  value={rewardClipboardText}
                  onChange={(e) => {
                    setRewardClipboardText(e.target.value);
                    setRewardImportPreview(parseClipboardText(e.target.value));
                  }}
                  placeholder="考试进步（10）\n主动帮助家务(5)\n迟到(-5)\n未按时完成作业（-10）\n..."
                  className="w-full px-3 py-2 border rounded-lg min-h-[120px]"
                />

                {/* 预览解析结果 */}
                {rewardImportPreview.length > 0 && (
                  <div className="mt-3">
                    <div className="border rounded-lg p-2 bg-gray-50">
                      <p className="text-gray-500 text-sm mb-2">
                        预览（{rewardImportPreview.length} 个奖惩）：
                      </p>
                      <div className="max-h-[200px] overflow-y-auto">
                        {rewardImportPreview.map((item, idx) => (
                          <div
                            key={idx}
                            className="flex items-center justify-between py-1 border-b border-gray-200 last:border-0"
                          >
                            <span className="text-gray-700">{item.name}</span>
                            <Badge
                              color={item.points > 0 ? "success" : "danger"}
                            >
                              {item.points > 0
                                ? `+${item.points}`
                                : item.points}
                              分
                            </Badge>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                <div className="flex gap-2 mt-4">
                  <Button
                    onClick={handleRewardClipboardImport}
                    disabled={rewardImportPreview.length === 0}
                  >
                    追加{" "}
                    {rewardImportPreview.length > 0 &&
                      `(${rewardImportPreview.length}个)`}
                  </Button>
                  <Button
                    variant="secondary"
                    onClick={handleRewardClipboardSave}
                    disabled={rewardImportPreview.length === 0}
                  >
                    保存并覆盖{" "}
                    {rewardImportPreview.length > 0 &&
                      `(${rewardImportPreview.length}个)`}
                  </Button>
                  <Button
                    variant="ghost"
                    onClick={() => {
                      setShowRewardClipboardImport(false);
                      setRewardClipboardText("");
                      setRewardImportPreview([]);
                    }}
                  >
                    取消
                  </Button>
                </div>
              </Card>
            )}
          </div>
        )}
        {/* 配置 */}
        {activeTab === "config" && (
          <div className="space-y-4">
            <Card>
              <h3 className="font-medium text-gray-700 mb-3 flex items-center gap-2">
                <Icon name="settings" size={20} />
                积分配置
              </h3>

              <div className="space-y-4">
                <div>
                  <label className="text-gray-500 text-sm">积分上限</label>
                  <div className="flex items-center gap-2 mt-1">
                    <input
                      type="number"
                      value={pointsConfig.pointsLimit}
                      onChange={(e) =>
                        setPointsConfig((prev) => ({
                          ...prev,
                          pointsLimit: parseInt(e.target.value) || 300,
                        }))
                      }
                      className="w-full px-3 py-2 border rounded-lg"
                    />
                    <span className="text-gray-500">分</span>
                  </div>
                </div>

                <div>
                  <label className="text-gray-500 text-sm">确认超时</label>
                  <div className="flex items-center gap-2 mt-1">
                    <input
                      type="number"
                      value={pointsConfig.confirmTimeout}
                      onChange={(e) =>
                        setPointsConfig((prev) => ({
                          ...prev,
                          confirmTimeout: parseInt(e.target.value) || 2,
                        }))
                      }
                      className="w-full px-3 py-2 border rounded-lg"
                    />
                    <span className="text-gray-500">小时</span>
                  </div>
                </div>
              </div>

              <Button
                className="w-full mt-4"
                onClick={() => alert("配置已保存")}
              >
                保存配置
              </Button>
            </Card>

            <Card>
              <h3 className="font-medium text-gray-700 mb-3 flex items-center gap-2">
                <Icon name="team" size={20} />
                家庭信息
              </h3>
              <div className="space-y-2">
                <div className="flex justify-between">
                  <span className="text-gray-500">家庭名称</span>
                  <span className="font-medium">{family?.name}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">家长</span>
                  <span className="font-medium">{parent?.name}</span>
                </div>
                <div className="flex justify-between">
                  <span className="text-gray-500">孩子</span>
                  <span className="font-medium">{child?.name}</span>
                </div>
              </div>
            </Card>
          </div>
        )}
      </div>
    </Page>
  );
}
